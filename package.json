{
  "name": "datanoa",
  "version": "1.2.0",
  "description": "Database client and SQL studio for Orca with opt-in AI SQL Assistant, SQL syntax diagnostics, and 7 local BYOD drivers — built-in SQLite, PostgreSQL, MySQL, MariaDB, CockroachDB, ClickHouse, Redis, LibSQL/Turso, Cloudflare D1, SQL Server (MSSQL), Oracle, and MongoDB.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build/bundle-drivers.mjs",
    "size": "node build/check-package-size.mjs",
    "types": "orca plugin types .",
    "typecheck": "npm run types && tsc --noEmit",
    "validate": "orca plugin validate .",
    "check": "orca plugin check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run build && npm run size && npm run typecheck && npm run validate && npm run check"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.18.0",
    "@types/oracledb": "^26.0.1",
    "@types/pg": "^8.11.0",
    "@types/pg-cursor": "^2.7.2",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.25.0",
    "fast-check": "^4.11.0",
    "mongodb": "7.9.1",
    "mssql": "12.8.1",
    "mysql2": "3.24.6",
    "oracledb": "26.0.0",
    "pg": "8.23.1",
    "pg-cursor": "2.22.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
