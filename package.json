{
  "name": "datanoa",
  "version": "1.0.2",
  "description": "All-in-one database client and SQL studio for Orca (SQLite, PostgreSQL, MySQL, MariaDB, CockroachDB, ClickHouse, Redis, Turso/LibSQL)",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build/bundle-drivers.mjs",
    "types": "orca plugin types .",
    "typecheck": "npm run types && tsc --noEmit",
    "validate": "orca plugin validate .",
    "check": "orca plugin check .",
    "test": "vitest run --config test/vitest.config.ts",
    "test:drivers": "vitest run test/drivers --config test/vitest.config.ts",
    "test:e2e": "vitest run test/e2e --config test/vitest.config.ts",
    "verify": "npm run build && npm run typecheck && npm run validate && npm run check && npm run test"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^24.18.0",
    "@types/pg": "^8.11.0",
    "@types/pg-cursor": "^2.7.2",
    "esbuild": "^0.25.0",
    "mysql2": "^3.12.0",
    "pg": "^8.13.0",
    "pg-cursor": "^2.12.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
